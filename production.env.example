ENVIRONMENT=production
APP_NAME=opinionated-genai-starter
API_PREFIX=/api/7r
MAX_GUNICORN_WORKERS=4
MAX_REQUEST_BODY_BYTES=1048576
MAX_CHAT_INPUT_CHARS=12000
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
MAX_CONCURRENT_REQUESTS_PER_CLIENT=16
TRUSTED_HOSTS=api.example.com,localhost,127.0.0.1
ALLOWED_ORIGINS=https://app.example.com
TRUST_PROXY_HEADERS=true
SECURITY_HEADERS_ENABLED=true
CAPTURE_RAW_TRACES=false
SQL_BACKEND=postgresql
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=app
PG_USERNAME=
PG_PASSWORD=
AUTH_PRIVATE_KEY_PATH=/run/secrets/auth_private_key
AUTH_PUBLIC_KEY_PATH=/run/secrets/auth_public_key
OPENAI_LLM_API_KEY=
OPENAI_LLM_MODEL=
